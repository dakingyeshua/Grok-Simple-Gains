# Optional. Tests and --fixtures sessions run without this key.
FINNHUB_API_KEY=

# Paper book persistence. Defaults to ./data/simple_gains.sqlite
SIMPLE_GAINS_DB=

# paper | hitl | live
SIMPLE_GAINS_MODE=paper

# Starting paper equity (used only when the book is first created)
SIMPLE_GAINS_STARTING_EQUITY=1000

# Optional extra fill slippage in basis points (longs fill worse)
SIMPLE_GAINS_SLIPPAGE_BPS=0

# Dashboard bind
SIMPLE_GAINS_HOST=127.0.0.1
SIMPLE_GAINS_PORT=8000
